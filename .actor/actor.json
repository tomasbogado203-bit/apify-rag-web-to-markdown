{
    "actorSpecification": 1,
    "name": "rag-web-to-markdown-extractor",
    "title": "AI & RAG Clean Web to Markdown Extractor - LLM & Vector DB Ready",
    "description": "Convert any webpage, documentation, or blog into clean, structured, token-optimized Markdown ready for LLMs, Vector DBs (Pinecone/Chroma), and RAG pipelines without HTML clutter.",
    "version": "0.0",
    "meta": {
        "templateId": "python-start"
    },
    "dockerfile": "../Dockerfile",
    "readme": "../README.md",
    "input": "./input_schema.json",
    "output": "./output_schema.json",
    "storages": {
        "dataset": {
            "actorSpecification": 1,
            "title": "RAG Markdown Dataset",
            "description": "Cleaned markdown documents with metadata, titles, and word counts.",
            "views": {
                "overview": {
                    "title": "Overview",
                    "transformation": {
                        "fields": [
                            "url",
                            "title",
                            "wordCount",
                            "estimatedTokens",
                            "headings",
                            "markdownContent"
                        ]
                    },
                    "display": {
                        "component": "table",
                        "columns": {
                            "url": {
                                "label": "Page URL"
                            },
                            "title": {
                                "label": "Title"
                            },
                            "wordCount": {
                                "label": "Words"
                            },
                            "estimatedTokens": {
                                "label": "Tokens"
                            },
                            "headings": {
                                "label": "Headings"
                            }
                        }
                    }
                }
            }
        }
    },
    "categories": [
        "AI",
        "DEVELOPER_TOOLS",
        "DATA_PROCESSING"
    ]
}